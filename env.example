# Файл-пример! Используйте переменные окружения / EnvironmentFile в systemd.
# Никогда не выкладывайте свой реальный токен в репозиторий.
DISCORD_BOT_TOKEN=PASTE_DISCORD_BOT_TOKEN_HERE
DISCORD_GUILD_ID=PASTE_NUMERIC_SERVER_ID_HERE
# Необязательный канал по умолчанию (после запуска настраивается /gp channel).
DISCORD_ANNOUNCE_CHANNEL_ID=
# Храните файл БД в постоянной директории, не очищаемой при перезапуске.
GP_DB_PATH=data/gp.sqlite3
